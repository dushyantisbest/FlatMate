<% layout("/layout/boilerplate.ejs") -%>

<div class="container mt-4">
  <div class="row">
    <div class="col-md-8 offset-md-2">
      <h2 class="mb-4">Your Inbox</h2>
      
      <% if (conversations.length === 0) { %>
        <div class="alert alert-info">
          You don't have any conversations yet. Start chatting by messaging an owner from their listing page!
        </div>
      <% } else { %>
        <div class="list-group">
          <% conversations.forEach(conv => { %>
            <% 
              const otherUser = conv.participants.find(p => p._id.toString() !== currUser._id.toString());
              const timeString = conv.updatedAt ? new Date(conv.updatedAt).toLocaleString() : 'No messages';
            %>
            <a href="/chat/<%= conv._id %>/messages" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
              <div>
                <h5 class="mb-1"><%= otherUser ? otherUser.username : 'Unknown User' %></h5>
                <p class="mb-1 text-muted small">
                  <% if (conv.listing) { %>
                    Regarding: <strong><%= conv.listing.title %></strong>
                  <% } else { %>
                    General chat
                  <% } %>
                </p>
                <p class="mb-1">
                  <% if (conv.lastMessage && conv.lastMessage.text) { %>
                    <span class="text-truncate d-inline-block" style="max-width: 400px;">
                      <% if (conv.lastMessage.sender.toString() === currUser._id.toString()) { %>
                        <strong>You:</strong> 
                      <% } %>
                      <%= conv.lastMessage.text %>
                    </span>
                  <% } else { %>
                    <em class="text-muted">No messages yet</em>
                  <% } %>
                </p>
              </div>
              <small class="text-muted"><%= timeString %></small>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</div>
