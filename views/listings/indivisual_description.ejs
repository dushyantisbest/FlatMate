<% layout("/layout/boilerplate.ejs") -%>

<div class="container py-4">
  <div class="row">
    <!-- Main Image Column -->
    <div class="col-lg-8 mb-4">
      <div class="position-relative overflow-hidden rounded-4 shadow-sm">
        <img
          src="<%= hotelData?.image?.url || 'https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?q=80&w=1200&auto=format&fit=crop' %>"
          alt="<%= hotelData.title %>"
          class="img-fluid w-100 individual-listing-img"
          style="max-height: 480px; object-fit: cover;"
        />
        <div class="position-absolute top-0 start-0 m-3 d-flex gap-2">
          <% if (hotelData.category) { %>
            <span class="badge px-3 py-2 text-uppercase fw-semibold" style="background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(6px); border-radius: 20px; font-size: 0.8rem; color: #fff;">
              <%= hotelData.category %>
            </span>
          <% } %>
          <% if (hotelData.roomType) { %>
            <span class="badge px-3 py-2 text-white" style="background: #E8456B; border-radius: 20px; font-size: 0.8rem;">
              <%= hotelData.roomType %>
            </span>
          <% } %>
        </div>
      </div>

      <!-- Description & Amenities -->
      <div class="card border-0 shadow-sm rounded-4 p-4 mt-4">
        <h4 class="fw-bold mb-3">About this Flatmate Space</h4>
        <p class="mb-4 text-muted" style="line-height: 1.7; font-size: 1.05rem;"><%= hotelData.description %></p>

        <!-- Flatmate Property Tags -->
        <h5 class="fw-bold mb-3">Property Features</h5>
        <div class="d-flex flex-wrap gap-2 mb-4">
          <div class="badge bg-light text-dark border p-2 px-3 rounded-pill d-flex align-items-center">
            <i class="fa-solid fa-person-half-dress text-danger me-2"></i>
            <span>Preference: <strong><%= hotelData.genderPreference || 'Any' %></strong></span>
          </div>
          <div class="badge bg-light text-dark border p-2 px-3 rounded-pill d-flex align-items-center">
            <i class="fa-solid fa-couch text-danger me-2"></i>
            <span>Furnishing: <strong><%= hotelData.furnishing || 'Furnished' %></strong></span>
          </div>
          <div class="badge bg-light text-dark border p-2 px-3 rounded-pill d-flex align-items-center">
            <i class="fa-solid fa-door-open text-danger me-2"></i>
            <span>Room: <strong><%= hotelData.roomType || 'Single Room' %></strong></span>
          </div>
        </div>
      </div>

      <!-- Mapbox Section -->
      <div class="card border-0 shadow-sm rounded-4 p-4 mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-map-location-dot me-2 text-danger"></i>Location & Neighborhood</h4>
            <p class="text-muted small mb-0"><i class="fa-solid fa-location-dot text-danger me-1"></i><%= hotelData.location %>, <%= hotelData.country %></p>
          </div>
        </div>
        <div id="map" class="rounded-3 overflow-hidden shadow-sm" style="width: 100%; height: 350px;"></div>
      </div>
    </div>

    <!-- Sticky Details & Host Column -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 100px;">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-baseline mb-3">
            <div>
              <h2 class="h1 fw-bold text-danger mb-0">&#x20B9;<%= hotelData.price ? hotelData.price.toLocaleString("en-IN") : 0 %></h2>
              <span class="text-muted small">per month</span>
            </div>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
              Available Now
            </span>
          </div>

          <p class="text-muted mb-4 small">
            <i class="fa-solid fa-location-dot me-1 text-danger"></i>
            <%= hotelData.location %>, <%= hotelData.country %>
          </p>

          <hr class="my-3" />

          <!-- Host Info -->
          <div class="d-flex align-items-center mb-4 p-3 bg-light rounded-3">
            <i class="fa-solid fa-circle-user fs-1 text-secondary me-3"></i>
            <div>
              <small class="text-muted d-block">Listed by</small>
              <h6 class="fw-bold mb-0"><%= hotelData.owner ? hotelData.owner.username : 'Property Owner' %></h6>
            </div>
          </div>

          <!-- Actions -->
          <% if (currUser && currUser.id === hotelData.owner.id) { %>
          <div class="text-center">
            <div class="d-grid listing-action-buttons gap-2">
              <form action="/listing/edit/<%= hotelData._id %>" method="get">
                <button type="submit" class="btn btn-outline-primary w-100 rounded-pill py-2">
                  <i class="fa-solid fa-edit me-1"></i> Edit Listing
                </button>
              </form>

              <form
                method="POST"
                action="/listing/delete/<%= hotelData._id %>?_method=DELETE"
              >
                <button type="submit" class="btn btn-outline-danger w-100 rounded-pill py-2">
                  <i class="fa-solid fa-trash me-1"></i> Delete Listing
                </button>
              </form>
            </div>
          </div>
          <% } %>

          <% if (!currUser) { %>
          <div class="text-center mt-3">
            <a href="/user/login" class="btn btn-danger w-100 py-3 rounded-pill fw-bold shadow-sm">
              <i class="fa-regular fa-message me-2"></i>Login to Message Owner
            </a>
          </div>
          <% } else if (currUser.id !== hotelData.owner.id) { %>
          <div class="text-center mt-3">
            <form action="/chat/start" method="POST">
              <input type="hidden" name="listingId" value="<%= hotelData._id %>">
              <input type="hidden" name="recipientId" value="<%= hotelData.owner._id %>">
              <button type="submit" class="btn btn-danger w-100 py-3 rounded-pill fw-bold shadow-sm">
                <i class="fa-regular fa-message me-2"></i>Message Owner in Real-Time
              </button>
            </form>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Reviews Section -->
<div class="container py-4">
  <div class="row">
    <div class="col-12">
      <h3 class="fw-bold mb-4">Reviews & Flatmate Feedback</h3>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4 mb-5">
        <% if (hotelData.reviews && hotelData.reviews.length > 0) { %>
          <% for(let review of hotelData.reviews ) { %>
          <div class="col">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-3">
              <div class="card-body p-2">
                <div class="d-flex align-items-center mb-3">
                  <i class="fa-solid fa-user-circle fs-3 text-secondary me-2"></i>
                  <div>
                    <h6 class="mb-0 fw-bold"><%= review.createdBy ? review.createdBy.username : 'Roommate' %></h6>
                    <div class="stars star-<%= review.rating %>"></div>
                  </div>
                </div>
                <p class="card-text text-muted mb-3"><%= review.comment %></p>

                <% if (currUser && review.createdBy && currUser.id === review.createdBy.id) { %>
                <form
                  method="post"
                  action="/listing/<%= hotelData._id %>/review/<%= review.id %>?_method=DELETE"
                  class="mt-2"
                >
                  <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">
                    <i class="fa-solid fa-trash-alt me-1"></i>Delete
                  </button>
                </form>
                <% } %>
              </div>
            </div>
          </div>
          <% } %>
        <% } else { %>
          <div class="col-12">
            <p class="text-muted">No reviews yet. Be the first flatmate to leave feedback!</p>
          </div>
        <% } %>
      </div>

      <!-- Review Form -->
      <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        <h4 class="fw-bold mb-3">Leave a Flatmate Review</h4>
        <form
          action="/listing/<%= hotelData._id %>/review"
          method="post"
          class="needs-validation"
          novalidate
        >
          <div class="mb-4">
            <label for="rating" class="form-label fw-bold mb-2">Rating</label>
            <div class="rating-container">
              <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="rating" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="rating" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="rating" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="rating" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="rating" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>
          </div>

          <div class="mb-4">
            <label for="comment" class="form-label fw-bold">Your Review</label>
            <textarea
              name="comment"
              rows="4"
              class="form-control"
              placeholder="Share your experience with this property and roommate compatibility..."
              required
            ></textarea>
            <div class="invalid-feedback">Please write your review</div>
          </div>

          <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 fw-semibold">Submit Review</button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Mapbox Script (mapboxgl is loaded in head) -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof mapboxgl !== 'undefined' && "<%= mapToken %>") {
      mapboxgl.accessToken = "<%= mapToken %>";
      let coordinates = <%- JSON.stringify(hotelData.geometry?.coordinates || [0, 0]) %>;
      
      // Fallback if not geocoded yet
      if (!coordinates || (coordinates[0] === 0 && coordinates[1] === 0)) {
        coordinates = [77.2090, 28.6139]; // Default city center
      }

      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const mapStyle = isDark ? 'mapbox://styles/mapbox/dark-v11' : 'mapbox://styles/mapbox/streets-v12';

      const map = new mapboxgl.Map({
        container: 'map',
        style: mapStyle,
        center: coordinates,
        zoom: 12
      });

      map.addControl(new mapboxgl.NavigationControl(), 'top-right');

      new mapboxgl.Marker({ color: '#E8456B' })
        .setLngLat(coordinates)
        .setPopup(new mapboxgl.Popup({ offset: 25 }).setHTML("<h6 class='fw-bold mb-1'><%= hotelData.title %></h6><p class='small text-muted mb-0'><%= hotelData.location %>, <%= hotelData.country %></p>"))
        .addTo(map);
    } else {
      console.warn("Mapbox GL JS is not loaded or MAPBOX_TOKEN is missing");
    }
  });
</script>
